# ==========================================
# DESI FUSION BITES - PRODUCTION ENVIRONMENT
# ==========================================

# 1. Supabase Configuration (Website Database, Storage & Auth)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# 2. Public Site URL
NEXT_PUBLIC_SITE_URL=https://desifusionbites.com

# 3. Odoo ERP Integration (Server-Side Secrets ONLY - Never expose to client/database records)
ODOO_ENABLED=false
ODOO_URL=https://your-company.odoo.com
ODOO_DB=desi_fusion_bites_prod
ODOO_USERNAME=api_integration_user
ODOO_API_KEY=your-odoo-api-key-or-password

# 4. Shipping Provider (Generic / Manual by default)
# Options: manual (default)
SHIPPING_PROVIDER=manual
