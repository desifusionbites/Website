# ==========================================
# DESI FUSION BITES - PRODUCTION ENVIRONMENT
# ==========================================

# 1. Supabase Configuration (Website Database, Storage & Auth)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# 2. Public Site URL
NEXT_PUBLIC_SITE_URL=https://desifusionbites.com

# 3. Razorpay Payment Gateway (Prepaid Checkout ONLY - No COD)
# Public Key (Safe for browser checkout modal)
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_your_key_id
# Secret Key (SERVER-SIDE ONLY - Never expose to browser)
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
# Webhook Secret (SERVER-SIDE ONLY - For verifying asynchronous webhooks)
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# 4. Shiprocket Logistics Integration (Server-Side Secrets ONLY)
SHIPPING_PROVIDER=shiprocket
SHIPROCKET_ENABLED=false
SHIPROCKET_EMAIL=your_shiprocket_account_email
SHIPROCKET_PASSWORD=your_shiprocket_account_password
SHIPROCKET_PICKUP_LOCATION=Primary

# 5. Odoo ERP Integration (Kept Disabled for launch)
ODOO_ENABLED=false
ODOO_URL=https://your-company.odoo.com
ODOO_DB=desi_fusion_bites_prod
ODOO_USERNAME=api_integration_user
ODOO_API_KEY=your-odoo-api-key-or-password

